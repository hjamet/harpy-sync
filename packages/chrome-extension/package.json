{
  "name": "@harpy/chrome-extension",
  "version": "1.0.0",
  "description": "Chrome Extension for Harpy.gg In-Browser Automation and Obsidian Sync Bridge",
  "private": true,
  "type": "module",
  "main": "dist/background/service-worker.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@harpy/core": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.1",
    "typescript": "^5.3.3"
  }
}
