{
  "name": "harpy-sync",
  "version": "0.0.1",
  "description": "Obsidian plugin to import/export notes using the harpy.gg .bypp format.",
  "main": "main.js",
  "scripts": {
    "dev": "esbuild main.ts --bundle --external:obsidian --outfile=main.js --format=cjs --target=es2022 --platform=node --sourcemap --watch",
    "build": "esbuild main.ts --bundle --external:obsidian --outfile=main.js --format=cjs --minify --target=es2022 --platform=node"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "harpy",
    "bypp",
    "ttrpg"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bypp-format": "github:harpygg/bypp-format",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.1",
    "obsidian": "^1.5.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
